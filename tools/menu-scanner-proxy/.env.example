# Gemini API Key (Get yours from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use for menu extraction
GEMINI_MODEL=gemini-3.5-flash-lite

# Proxy port (local-only loopback)
PORT=8787

# Upstream Gemini request timeout in milliseconds (90-120 seconds recommended)
GEMINI_TIMEOUT_MS=100000

# Maximum attempts for transient upstream errors (503, 429, timeout)
GEMINI_MAX_RETRIES=3


