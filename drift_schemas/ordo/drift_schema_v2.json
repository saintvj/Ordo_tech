  "fixed_sql": [
    {
      "name": "gatherings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"gatherings\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"restaurant_name\" TEXT NOT NULL, \"host_name\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"status\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "menu_categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"menu_categories\" (\"gathering_id\" TEXT NOT NULL REFERENCES gatherings (id) ON DELETE CASCADE, \"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"gathering_id\", \"id\"));"
        }
      ]
    },
    {
      "name": "menu_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"menu_items\" (\"gathering_id\" TEXT NOT NULL REFERENCES gatherings (id) ON DELETE CASCADE, \"category_id\" TEXT NOT NULL, \"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"price_paise\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"gathering_id\", \"id\"), FOREIGN KEY (gathering_id, category_id) REFERENCES menu_categories (gathering_id, id) ON DELETE CASCADE, CHECK (price_paise > 0));"
        }
      ]
    },
    {
      "name": "participants",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"participants\" (\"id\" TEXT NOT NULL, \"gathering_id\" TEXT NOT NULL REFERENCES gatherings (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"gathering_id\", \"id\"));"
        }
      ]
    },
    {
      "name": "order_lines",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"order_lines\" (\"id\" TEXT NOT NULL, \"gathering_id\" TEXT NOT NULL REFERENCES gatherings (id) ON DELETE CASCADE, \"participant_id\" TEXT NOT NULL, \"menu_item_id\" TEXT NOT NULL, \"item_name\" TEXT NOT NULL, \"unit_price_paise\" INTEGER NOT NULL, \"quantity\" INTEGER NOT NULL, \"served_quantity\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), FOREIGN KEY (gathering_id, participant_id) REFERENCES participants (gathering_id, id) ON DELETE CASCADE, CHECK (unit_price_paise >= 0), CHECK (quantity > 0), CHECK (served_quantity BETWEEN 0 AND quantity));"
        }
      ]
    }
  ]
